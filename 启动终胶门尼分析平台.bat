@echo off
chcp 65001 >nul
title Continental 终胶密炼过程曲线与门尼全车次智能预测平台

echo ======================================================================
echo    Continental Tires - 终胶密炼过程曲线与门尼全车次智能预测平台
echo ======================================================================
echo.
echo [1/2] 正在启动后台分析引擎与 Web 服务...
echo.

:: 启动后台服务并等待端口就绪
start /b python app.py

:: 稍等 2 秒以确保服务监听 5050 端口
timeout /t 2 /nobreak >nul

echo [2/2] 正在自动打开浏览器访问系统: http://127.0.0.1:5050
start http://127.0.0.1:5050

echo.
echo ======================================================================
echo  平台已成功启动！
echo  浏览器访问地址: http://127.0.0.1:5050
echo  支持功能:
echo    - 输入任意工单号实时拉取 SFE 与 Redshift 数据库
echo    - 全工单 1 ~ N 所有车次门尼偏差自动预测与宏观演化大屏
echo    - 任意双车次深度对比、11 阶段工艺窗口物理量对照表、五维曲线逐秒叠加
echo    - 门尼偏差多阶段物理量瀑布分解归因 (Waterfall Attribution)
echo    - 全车次数据明细导出为 CSV 报表
echo ======================================================================
echo.
echo 保持此窗口打开以维持服务运行，按任意键或关闭窗口可退出服务。
pause >nul
